# 默认忽略的文件
.idea/
/shelf/
/workspace.xml

# 基于编辑器的 HTTP 客户端请求
/httpRequests/

# --- 针对 ronin-net 模块的忽略规则 ---

# 忽略训练输出目录 (对应你路径中的 denoise/output)
ronin-net/denoise/output/
ronin-net/denoise/output_csv_moe/

# 忽略 Tensorboard 运行日志 (对应你路径中的 denoise/runs)
ronin-net/denoise/runs/

# 忽略测试生成的 CSV 文件 (对应你路径中的 test_csv)
ronin-net/test_csv/

# 忽略大型数据集文件 (建议加上，防止 Push 失败)
ronin-net/data/all_data/

# 忽略模型权重文件
*.pth
*.pt
ronin-net/weights/

# Python 缓存
__pycache__/
*.pyc